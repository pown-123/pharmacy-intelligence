generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  branches  Branch[]
  users     User[]

  products       Product[]
  categories     Category[]
  suppliers      Supplier[]
  customers      Customer[]
  batches        Batch[]
  sales          Sale[]
  purchases      Purchase[]
  stockSnapshots StockSnapshot[]
  wantedItems    WantedItem[]
  uploads        Upload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  address        String?
  users          User[]

  batches        Batch[]
  sales          Sale[]
  purchases      Purchase[]
  stockSnapshots StockSnapshot[]
  wantedItems    WantedItem[]
  uploads        Upload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(STAFF)
  emailVerified  DateTime?
  image          String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, role])
}

model Category {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?      @db.Uuid
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  sku            String?
  batches        Batch[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  wantedItems    WantedItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
}

model Supplier {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  purchases      Purchase[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Customer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  sales          Sale[]
  wantedItems    WantedItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, phone])
}

model Batch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber    String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, productId])
}

model Sale {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  occurredAt     DateTime     @default(now())
  items          SaleItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, occurredAt])
}

model SaleItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String  @db.Uuid
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal @db.Decimal(12, 3)
  amount    Decimal @db.Decimal(12, 2)
}

model Purchase {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId     String?      @db.Uuid
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  occurredAt     DateTime     @default(now())
  items          PurchaseItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, occurredAt])
}

model PurchaseItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId String   @db.Uuid
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(12, 3)
  amount     Decimal  @db.Decimal(12, 2)
}

model StockSnapshot {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  capturedAt     DateTime     @default(now())
  sourceUploadId String?      @db.Uuid
  sourceUpload   Upload?      @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, capturedAt])
}

model WantedItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
}

model Upload {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String          @db.Uuid
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fileName       String
  status         UploadStatus    @default(PENDING)
  stockSnapshots StockSnapshot[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
}
